PORT=3000
# Web OAuth client ID from Google Cloud. No client secret is needed for GIS.
GOOGLE_CLIENT_ID=
# Generate a long random secret before deploying. Never expose this in VITE_*.
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: comma-separated frontend origins in production.
# CORS_ORIGIN=https://your-frontend.example
# Optional absolute Prisma SQLite URL. Default: api/prisma/dev.db
# DATABASE_URL=file:C:/path/to/career-fit.db
